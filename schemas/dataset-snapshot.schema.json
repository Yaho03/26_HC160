{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hc160.local/schemas/dataset-snapshot.schema.json",
  "title": "HC160 dataset snapshot metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "dataset_id",
    "manifest_relative_uri",
    "manifest_sha256",
    "source_archive_sha256",
    "source_uri",
    "source_retrieved_at",
    "license_id",
    "identity_token_policy",
    "row_count",
    "identity_count",
    "split_counts",
    "created_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "manifest_relative_uri": {"type": "string", "minLength": 1, "not": {"pattern": "^(?:/|[A-Za-z]:[\\\\/])"}},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_archive_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_uri": {"type": "string", "format": "uri"},
    "source_retrieved_at": {"type": "string", "format": "date"},
    "license_id": {"type": "string", "minLength": 1},
    "identity_token_policy": {"type": "string", "minLength": 1},
    "row_count": {"type": "integer", "minimum": 1},
    "identity_count": {"type": "integer", "minimum": 1},
    "split_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "calibration", "development", "test"],
      "properties": {
        "train": {"type": "integer", "minimum": 0},
        "calibration": {"type": "integer", "minimum": 0},
        "development": {"type": "integer", "minimum": 0},
        "test": {"type": "integer", "minimum": 0}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
