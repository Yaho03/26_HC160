{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hc160.local/schemas/run-registration-context.schema.json",
  "title": "HC160 output registration context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "requirement_ids",
    "environment_sha256",
    "seed",
    "input_artifact_ids",
    "reproduce_command",
    "artifact_id",
    "relative_uri"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "pattern": "^EXP-[A-Z]+-[0-9]{3}$"},
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"}
    },
    "environment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "seed": {"type": "integer", "minimum": 0},
    "input_artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "reproduce_command": {"type": "string", "minLength": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "relative_uri": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "^(?:/|[A-Za-z]:[\\\\/])"}
    },
    "notes": {"type": ["string", "null"], "minLength": 1}
  }
}
