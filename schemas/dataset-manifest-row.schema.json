{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hc160.local/schemas/dataset-manifest-row.schema.json",
  "title": "HC160 dataset manifest row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "sample_id",
    "identity_token",
    "relative_uri",
    "media_sha256",
    "split",
    "width_px",
    "height_px",
    "license_id"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "dataset_id": {"type": "string", "minLength": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "identity_token": {"type": "string", "minLength": 1},
    "relative_uri": {"type": "string", "minLength": 1, "not": {"pattern": "^(?:/|[A-Za-z]:[\\\\/])"}},
    "media_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "split": {"enum": ["train", "calibration", "development", "test"]},
    "width_px": {"type": "integer", "minimum": 1},
    "height_px": {"type": "integer", "minimum": 1},
    "license_id": {"type": "string", "minLength": 1},
    "source_uri": {"type": ["string", "null"], "format": "uri"}
  }
}
