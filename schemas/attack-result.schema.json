{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hc160.local/schemas/attack-result.schema.json",
  "title": "HC160 attack result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attack_result_id",
    "run_id",
    "pair_id",
    "attack_id",
    "threat_model",
    "attack_params",
    "model_artifact_id",
    "threshold_artifact_id",
    "similarity_before",
    "similarity_after",
    "accepted_before",
    "accepted_after",
    "success_from_reject",
    "elapsed_ms",
    "status"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "attack_result_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "pair_id": {"type": "string", "minLength": 1},
    "attack_id": {"type": "string", "minLength": 1},
    "threat_model": {"enum": ["white_box", "score_black_box", "decision_black_box", "transfer", "adaptive"]},
    "attack_params": {"type": "object"},
    "model_artifact_id": {"type": "string", "minLength": 1},
    "threshold_artifact_id": {"type": "string", "minLength": 1},
    "similarity_before": {"type": "number"},
    "similarity_after": {"type": "number"},
    "accepted_before": {"type": "boolean"},
    "accepted_after": {"type": "boolean"},
    "success_from_reject": {"type": "boolean"},
    "elapsed_ms": {"type": "number", "minimum": 0},
    "status": {"enum": ["ok", "failed", "timeout", "error"]},
    "epsilon": {"type": ["number", "null"], "minimum": 0},
    "alpha": {"type": ["number", "null"], "minimum": 0},
    "steps": {"type": ["integer", "null"], "minimum": 0},
    "queries_used": {"type": ["integer", "null"], "minimum": 0},
    "l0": {"type": ["number", "null"], "minimum": 0},
    "l2": {"type": ["number", "null"], "minimum": 0},
    "linf": {"type": ["number", "null"], "minimum": 0},
    "norm_space": {"type": ["string", "null"]},
    "source_artifact_id": {"type": ["string", "null"]},
    "target_enroll_artifact_id": {"type": ["string", "null"]},
    "adversarial_artifact_id": {"type": ["string", "null"]},
    "perturbation_artifact_id": {"type": ["string", "null"]},
    "error_code": {"type": ["string", "null"]}
  }
}
