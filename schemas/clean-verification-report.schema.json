{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hc160.local/schemas/clean-verification-report.schema.json",
  "title": "HC160 clean verification report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "report_id",
    "protocol_id",
    "model_artifact_id",
    "model_artifact_sha256",
    "preprocessing_artifact_id",
    "preprocessing_artifact_sha256",
    "threshold_artifact_id",
    "frozen_threshold",
    "selection_method",
    "calibration_target_far",
    "test_manifest_id",
    "test_manifest_sha256",
    "test_score_export_sha256",
    "test_pair_ids_sha256",
    "test_pair_count",
    "genuine_pair_count",
    "impostor_pair_count",
    "confusion_counts",
    "rates",
    "wilson_95_intervals",
    "test_roc_auc",
    "descriptive_test_eer",
    "generated_by_run_id",
    "created_at",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"const": "EXP-VER-001"},
    "report_id": {"type": "string", "minLength": 1},
    "protocol_id": {"type": "string", "minLength": 1},
    "model_artifact_id": {"type": "string", "minLength": 1},
    "model_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "preprocessing_artifact_id": {"type": "string", "minLength": 1},
    "preprocessing_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "threshold_artifact_id": {"type": "string", "minLength": 1},
    "frozen_threshold": {"type": "number"},
    "selection_method": {"enum": ["target_far", "eer"]},
    "calibration_target_far": {"type": ["number", "null"]},
    "test_manifest_id": {"type": "string", "minLength": 1},
    "test_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "test_score_export_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "test_pair_ids_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "test_pair_count": {"type": "integer", "minimum": 2},
    "genuine_pair_count": {"type": "integer", "minimum": 1},
    "impostor_pair_count": {"type": "integer", "minimum": 1},
    "confusion_counts": {"type": "object"},
    "rates": {"type": "object"},
    "wilson_95_intervals": {"type": "object"},
    "test_roc_auc": {"type": "number", "minimum": 0, "maximum": 1},
    "descriptive_test_eer": {"type": "object"},
    "generated_by_run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
